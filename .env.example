# Stealth Dev Console Configuration

# Discord Bot Token (Optional - get from discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_PREFIX=!

# UI Preferences
# MASK_MODE: "stealth" (disguised as backend syslog) or "clean" (clean terminal chat)
DEFAULT_VIEW_MODE=stealth

# Fake log speed for Panic Mode (milliseconds)
PANIC_SPEED_MS=80
